<style>
    .contact {
        scroll-margin-top: var(--header-size);
        padding: 4rem 2rem;
        max-width: 1300px;
        margin: 10vh auto 5vh auto;
    }

    .contact h2 {
        font-size: 2rem;
        margin-bottom: 2rem;
        text-align: center;
    }

    .contact-container {
        display: flex;
        flex-wrap: wrap;
        gap: 3rem;
        background: rgba(255, 255, 255, 0.05); 
        backdrop-filter: blur(10px);
        padding: 2.5rem;
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .contact-info, .contact-form {
        flex: 1;
        min-width: 300px;
    }

    .contact-info h3 {
        margin-bottom: 1rem;
        color: var(--accent-pink); 
    }

    .email-display a {
        color: #fff;
        text-decoration: none;
        border-bottom: 1px dashed var(--accent-pink);
        transition: color 0.3s;
    }

    .email-display a:hover {
        color: var(--accent-pink);
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-group label {
        display: block;
        margin-bottom: 0.5rem;
        font-size: 0.9rem;
        font-weight: 600;
    }

    .contact-form input,
    .contact-form select,
    .contact-form textarea {
        width: 100%;
        padding: 0.8rem;
        background: rgba(0, 0, 0, 0.2);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 6px;
        color: #fff;
        font-family: inherit;
        box-sizing: border-box;
    }

    .contact-form input:focus,
    .contact-form select:focus,
    .contact-form textarea:focus {
        outline: none;
        border-color: var(--accent-pink);
        box-shadow: 0 0 8px rgba(255, 218, 233, 0.2); 
    }

    .contact-form input:-webkit-autofill,
    .contact-form input:-webkit-autofill:hover, 
    .contact-form input:-webkit-autofill:focus,
    .contact-form textarea:-webkit-autofill,
    .contact-form textarea:-webkit-autofill:hover,
    .contact-form textarea:-webkit-autofill:focus,
    .contact-form select:-webkit-autofill,
    .contact-form select:-webkit-autofill:hover,
    .contact-form select:-webkit-autofill:focus {
        border: 1px solid rgba(255, 255, 255, 0.2);
        -webkit-box-shadow: 0 0 0px 1000px transparent inset;
        box-shadow: 0 0 0px 1000px transparent inset;
        transition: background-color 500000s ease-in-out 0s;
        -webkit-text-fill-color: #fff !important;
    }

    .contact-form select {
        appearance: none;          
        -webkit-appearance: none;   
        -moz-appearance: none;      
        background-image: url("data:image/svg+xml;charset=UTF-8,<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%23FFDAE9' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polyline points='6 9 12 15 18 9'></polyline></svg>");
        background-repeat: no-repeat;
        background-position: right 1rem center;
        background-size: 1em;
        padding-right: 2.5rem;      
        cursor: pointer;
    }

    .contact-form select option {
        background-color: var(--bg-card); 
        color: var(--text-light);
        padding: 10px;
    }

    .contact-form select option:hover,
    .contact-form select option:focus,
    .contact-form select option:active,
    .contact-form select option:checked {
        background-color: var(--muted-blue) !important;
        color: var(--accent-pink) !important;
        box-shadow: 0 0 10px var(--muted-blue) inset;
    }

    .contact-form select option:disabled {
        color: var(--muted-blue);
    }

    @media screen and (max-width: 768px) {
        .contact {
            scroll-margin-top: var(--header-phone-size);
            padding: 3rem 1rem;
        }

        .contact h2 {
            font-size: 1.6rem;
            margin-bottom: 1.5rem;
        }

        .contact-container {
            background-color: var(--bg-card);
            padding: 1.5rem;
            gap: 2rem;
            flex-direction: column;
        }

        .contact-info, .contact-form {
            min-width: 100%;
            text-align: center;
        }

        .form-group label {
            text-align: left;
        }
    }
</style>

<% if (lang === 'nl') { %>
    <section class="contact" id="contact">
        <h2>Neem Contact Op</h2>
        <div class="contact-container">
            <div class="contact-info">
                <h3>Contactgegevens</h3>
                <p>Stuur gerust een bericht! Je kunt rechtstreeks via het formulier contact opnemen of handmatig een e-mail sturen.</p>
                <p class="email-display">
                    <strong>E-mail:</strong> <a href="mailto:matthiasvanhogerhuis017@gmail.com">matthiasvanhogerhuis017@gmail.com</a>
                </p>
            </div>

            <form action="/nl/send-email" method="POST" class="contact-form">
                <div class="form-group">
                    <label for="subject">Reden voor contact:</label>
                    <select name="subject" id="subject" required>
                        <option value="" disabled selected>Kies een optie...</option>
                        <option value="Project Samenwerking">Project Samenwerking</option>
                        <option value="Inhuur / Vacature">Inhuur / Vacature</option>
                        <option value="Vraag / Feedback">Vraag / Feedback</option>
                        <option value="Anders">Anders</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="email">Jouw E-mailadres:</label>
                    <input type="email" name="email" id="email" placeholder="voorbeeld@domein.com" required>
                </div>

                <div class="form-group">
                    <label for="message">Bericht:</label>
                    <textarea name="message" id="message" rows="6" placeholder="Schrijf hier je bericht..." required></textarea>
                </div>

                <button type="submit" class="btn">Bericht Verzenden</button>
            </form>
        </div>
    </section>
<% } else if (lang === 'en') { %>
    <section class="contact" id="contact">
        <h2>Get in Touch</h2>
        <div class="contact-container">
            <div class="contact-info">
                <h3>Contact Information</h3>
                <p>Feel free to reach out! You can send a message directly through the form, or drop an email manually.</p>
                <p class="email-display">
                    <strong>Email:</strong> <a href="mailto:matthiasvanhogerhuis017@gmail.com">matthiasvanhogerhuis017@gmail.com</a>
                </p>
            </div>

            <form action="/en/send-email" method="POST" class="contact-form">
                <div class="form-group">
                    <label for="subject">Reason for contacting:</label>
                    <select name="subject" id="subject" required>
                        <option value="" disabled selected>Select an option...</option>
                        <option value="Project Collaboration">Project Collaboration</option>
                        <option value="Job Opportunity">Job Opportunity</option>
                        <option value="Question / Feedback">Question / Feedback</option>
                        <option value="Other">Other</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="email">Your Email:</label>
                    <input type="email" name="email" id="email" placeholder="example@domain.com" required>
                </div>

                <div class="form-group">
                    <label for="message">Message:</label>
                    <textarea name="message" id="message" rows="6" placeholder="Write your message here..." required></textarea>
                </div>

                <button type="submit" class="btn">Send Message</button>
            </form>
        </div>
    </section>
<% } else { %>
    <%- include("partials/logic/handleLanguageUnknown") %>
<% } %>