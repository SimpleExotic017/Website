<style>
    .about {
    scroll-margin-top: var(--header-size);
    margin-top: 5vh;
    max-width: 1300px;
    margin: 0 auto 15vh auto;
    padding: 4rem 5%;
}

.about h2 {
    font-size: 2rem;
    margin-bottom: 2rem;
    color: var(--text-light);
    border-left: 4px solid var(--accent-pink);
    padding-left: 10px;
}

.about-container {
    display: flex;
    flex-wrap: wrap;
    gap: 4rem;
    align-items: center; 
}

.about-visual {
    flex: 1;
    min-width: 300px;
    display: flex;
    justify-content: center;
}

.profile-frame {
    position: relative;
    width: 100%;
    max-width: 350px;
    aspect-ratio: 1 / 1;
    border-radius: 12px;
    border: 1px solid var(--muted-blue);
    background-color: var(--bg-card);
    padding: 1rem;
    transition: transform 0.3s, border-color 0.3s;
}

.profile-frame:hover {
    transform: translateY(-5px);
    border-color: var(--light-blue);
}

.profile-placeholder {
    width: 100%;
    height: 100%;
    background-color: var(--bg-dark);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px dashed var(--muted-blue);
}

.profile-placeholder span {
    font-family: 'Courier New', Courier, monospace;
    font-size: 2rem;
    color: var(--accent-pink);
    font-weight: bold;
}

.about-content {
    flex: 1.5;
    min-width: 300px;
}

.about-content h3 {
    font-size: 1.8rem;
    color: var(--text-light);
    margin-bottom: 1.5rem;
}

.about-content p {
    color: var(--light-blue);
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
}

.about-skills h4 {
    color: var(--text-light);
    font-size: 1.1rem;
    margin-bottom: 0.8rem;
}

.skills-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
}

.skills-grid span {
    font-size: 0.85rem;
    background-color: var(--bg-card);
    color: var(--text-light);
    padding: 0.4rem 1rem;
    border-radius: 20px; 
    border: 1px solid var(--muted-blue);
    font-weight: 500;
    transition: border-color 0.2s, color 0.2s;
}

.skills-grid span:hover {
    border-color: var(--accent-pink);
    color: var(--accent-pink);
}

@media screen and (max-width: 768px) {
    .about {
        scroll-margin-top: var(--header-phone-size);
        padding: 3rem 5%;
    }

    .about h2 {
        font-size: 1.6rem;
    }

    .about-container {
        gap: 2rem;
        flex-direction: column;
    }

    .about-visual,
    .about-content {
        min-width: 100%;
    }

    .profile-frame {
        max-width: 280px;
    }

    .about-content h3 {
        font-size: 1.4rem;
        margin-bottom: 1rem;
        text-align: center;
    }

    .about-content p {
        font-size: 1rem;
        text-align: center;
    }

    .about-skills h4 {
        text-align: center;
    }

    .skills-grid {
        justify-content: center;
    }
}
</style>
<section class="about" id="aboutme">
