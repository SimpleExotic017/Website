<style>
.projects {
    scroll-margin-top: var(--header-size);
    max-width: 1300px;
    margin: 0vh auto 15vh auto;
    padding: 4rem 5%;
}

.projects h2 {
    font-size: 2rem;
    margin-bottom: 2rem;
    color: var(--text-light);
    border-left: 4px solid var(--accent-pink);
    padding-left: 10px;
}

.project-grid {
    display: grid;
    justify-content: center;
    grid-template-columns: minmax(300px,1fr) minmax(300px,1fr) minmax(300px,1fr);
    gap: 2rem;
}

.card {
    background-color: var(--bg-card);
    border-radius: 8px;
    padding: 2rem;
    border: 1px solid var(--muted-blue);
    transition: transform 0.3s;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
}

.card:hover {
    transform: translateY(-5px);
    border-color: var(--light-blue);
}

.card-tag {
    font-size: 0.8rem;
    text-transform: uppercase;
    color: var(--accent-pink);
    letter-spacing: 1px;
    margin-bottom: 0.5rem;
    display: block;
}

.card h3 {
    margin-bottom: 1rem;
    color: var(--text-light);
}

.card p {
    color: var(--light-blue);
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
    flex-grow: 1;
}

.card-languages {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem; 
}

.card-languages span {
    font-size: 0.75rem;
    background-color: var(--bg-dark); 
    color: var(--accent-pink); 
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    border: 1px solid var(--muted-blue); 
    font-weight: 500;
}

.projects-action {
    display: flex;
    justify-content: center;
    margin-top: 3rem; 
}

.projects-action .btn-outline {
    margin-left: 0;
}

/* Mobiele styling voor de projecten-sectie en grid */
@media screen and (max-width: 768px) {
    .projects {
        margin: 0vh auto 4vh auto;
        padding: 3rem 5%;
        scroll-margin-top: var(--header-phone-size);
    }

    .projects h2 {
        font-size: 1.6rem;
    }

    .project-grid {
        grid-template-columns: 1fr;
        gap: 1.5rem;
    }

    .card {
        padding: 1.5rem;
    }

    .projects-action {
        margin-top: 2rem;
    }
}
</style>
<section class="projects" id="projects">
        <h2>Notable projects</h2>
        <div class="project-grid">
            <%if (projects.length > 0){%>
                <%for(let project of projects){%>
                    <div class="card">
                        <span class="card-tag"><%=project.category%></span>
                        <h3><%=project.name%></h3>
                        <div class="card-languages">
                            <%for(let language of project.languages){%>
                                <span><%=language%></span>    
                            <%}%>
                        </div>
                        <p><%=project.description%></p>
                        <a href="/projects/<%=project.name%>" style="color: var(--accent-pink); text-decoration: none; font-size: 0.9rem;">Read More &rarr;</a>
                    </div>
                <%}%>
            <%}%>
        </div>

        <div class="projects-action">
            <a href="/projects" class="btn btn-outline">View More Projects &rarr;</a>
        </div>
    </section>