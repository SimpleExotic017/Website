<style>
    html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    max-width: 100vw;
    overflow-x: hidden; 
}

body {
    position: relative;
}

.floating-bg {
    position: fixed; 
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh; 
    z-index: -1; 
    pointer-events: none;
    overflow: hidden;
    contain: layout size style;
}

.icon {
    position: absolute;
    font-family: 'Courier New', Courier, monospace;
    font-weight: bold;
    color: var(--muted-blue);
    opacity: 0.15; 
    font-size: 2rem;
    filter: blur(0.5px);
    animation: floatAnimation 6s ease-in-out infinite;
    user-select: none;
    will-change: transform; 
}

.icon:nth-child(3n) { 
    animation-duration: 9s; 
    animation-delay: 1s; 
    color: var(--light-blue); 
    font-size: 2.5rem;
}
.icon:nth-child(5n) { 
    animation-duration: 12s; 
    animation-delay: 3s; 
    color: var(--accent-pink); 
    opacity: 0.1; 
}
.icon:nth-child(7n) { 
    animation-duration: 7s; 
    font-size: 1.5rem;
}

@keyframes floatAnimation {
    0% {
        transform: translate(0, 0) rotate(0deg);
    }
    50% {
        transform: translate(5px, -15px) rotate(5deg); 
    }
    100% {
        transform: translate(0, 0) rotate(0deg);
    }
}

@media (max-width: 768px) {
    .icon {
        font-size: 1.2rem;
        opacity: 0.1;
    }

    .icon:nth-child(3n) { 
        font-size: 1.4rem;
    }

    .icon:nth-child(7n) { 
        font-size: 0.9rem;
    }

    .icon:nth-child(even) {
        display: none;
    }
}
</style>
<div class="floating-bg">
    <% 
        const iconCount = 40;
        const techIcons = [
            'JS' ,
            'C#',
            '⚛',
            'Py',
            'TS',
            'C++',
            '☕',
            'HTML',
            'Java'
        ];

        for (let i = 0; i < iconCount; i++) {
            let icon = techIcons[i % techIcons.length];
            let baseTop = (i / iconCount) * 85 + 5; 
            let variation = (Math.random() * 6) - 3; 
            let randomTop = Math.max(2, Math.min(98, baseTop + variation)); 
            let randomRight = Math.floor(Math.random() * 96) + 2; 
    %>
        <div class="icon" style="top: <%= randomTop %>%; right: <%= randomRight %>%;">
            <%= icon %>
        </div>
    <% } %>
    </div>