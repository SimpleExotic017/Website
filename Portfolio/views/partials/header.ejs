<header>
    <a href="/<%= lang %>/" class="logo">Matthias van Hogerhuis</a>
    <div class="nav-wrapper">
        <nav>
            <% if (lang === 'nl') { %>
                <a href="/nl/" <% if(page == ""){ %>class="active"<% } %>>Home</a>
                <a href="/nl/projects" <% if(page == "projects"){ %>class="active"<% } %>>Projecten</a>
                <a href="/nl/aboutme" <% if(page == "aboutme"){ %>class="active"<% } %>>Over mij</a>
                <a href="/nl/contact" <% if(page == "contact"){ %>class="active"<% } %>>Contact</a>
            <% } else if (lang === 'en') { %>
                <a href="/en/" <% if(page == ""){ %>class="active"<% } %>>Home</a>
                <a href="/en/projects" <% if(page == "projects"){ %>class="active"<% } %>>Projects</a>
                <a href="/en/aboutme" <% if(page == "aboutme"){ %>class="active"<% } %>>About me</a>
                <a href="/en/contact" <% if(page == "contact"){ %>class="active"<% } %>>Contact</a>
            <% } else { %>
                <%- include("/logic/handleLanguageUnknown") %>
            <% } %>
        </nav>
        
        <div class="lang-dropdown">
            <button class="lang-btn">
                🌐 <%= typeof lang !== 'undefined' && (lang === 'nl' || lang === 'en') ? lang.toUpperCase() : '??' %> ▾
            </button>
            <div class="dropdown-content">
                <div class="dropdown-content-inner">
                    <a href="/en/<%= page %>" <% if(lang === 'en'){ %>class="active-lang"<% } %>>English</a>
                    <a href="/nl/<%= page %>" <% if(lang === 'nl'){ %>class="active-lang"<% } %>>Nederlands</a>
                </div>
            </div>
        </div>
    </div>
</header>