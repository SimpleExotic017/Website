<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include("../partials/default")%>
    <link rel="stylesheet" href="/css/projectdetails.css">
    <title><%= project.name %> - Details</title>
</head>
<body>
    <%- include("../partials/floatingbg")%>
    <%- include("partials/header")%>

    <main class="detail-container">
        <a href="/en/#projects" class="back-link">← Back to home</a>

        <div class="project-header-premium">
            <div class="title-meta-group">
                <h1 class="gradient-title"><%= project.name %></h1>

                <div class="header-top-meta">
                    <% if (project.notable) { %>
                        <div class="notable-badge">
                            <span class="pulse-star">★</span> <%= project.category %>
                        </div>
                    <% } else { %>
                        <div class="standard-badge">
                            <span class="category-indicator"></span>
                            <span class="category-tag"><%= project.category %></span>
                        </div>
                    <% } %>
                </div>
            </div>
            
            <div class="tech-stack-container">
                <span class="tech-label">Technologies used:</span>
                <div class="tech-stack">
                    <% project.languages.forEach(function(lang) { %>
                        <span class="lang-tag"><%= lang %></span>
                    <% }); %>
                </div>
            </div>
        </div>

        <div class="project-cover">
            <img src="/assets/project-images/<%= project.name %>.png" alt="<%= project.name %> Cover">
        </div>

        <section class="project-walkthrough">
            <% 
            project.description.slice(1).forEach(function(paragraph, sliceIndex) { 
                let i = sliceIndex + 1; 
                let imageIndex = i; 
                let hasImage = project.detailImageCount && imageIndex <= project.detailImageCount;
                let isLastStep = (sliceIndex === project.description.slice(1).length - 1);
            %>
                <div class="walkthrough-step <%= hasImage ? ((sliceIndex % 2 === 0) ? 'normal-row' : 'reverse-row') : 'full-width-row' %> <%= isLastStep && project.gitURL ? 'last-step-with-git' : '' %>">
                    
                    <div class="step-text">
                        <span class="step-number">0<%= sliceIndex + 1 %></span>
                        <p><%= paragraph %></p>
                    </div>

                    <% if (hasImage) { %>
                        <div class="step-image-wrapper">
                            <img src="/assets/project-detail-images/<%= project.name %>/<%= imageIndex %>.png" alt="<%= project.name %> Detail Screenshot <%= imageIndex %>" loading="lazy">
                        </div>
                    <% } %>

                </div>
            <% }); %>

            
        </section>

        <div class="bottom-back-container">
            <% if (project.gitURL) { %>
                    <a href="<%= project.gitURL %>" target="_blank" rel="noopener noreferrer" class="github-btn">
                        View Source Code on GitHub ↗
                    </a>
            <% } %>
            <a href="/en/#projects" class="back-btn-premium">
                ← Return to home
            </a>
        </div>
    </main>

    <%- include("partials/footer")%>
</body>
</html>