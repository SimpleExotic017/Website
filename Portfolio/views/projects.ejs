<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include("partials/default") %>
    <link rel="stylesheet" href="/css/projects.css">
    <title>
        <% if (lang === 'nl') { %>Projecten<% } else if (lang === 'en') { %>Projects<% } else { %><%- include("partials/handleLanguageUnknown") %><% } %>
    </title>
</head>
<body>
    <% if (lang !== 'nl' && lang !== 'en') { %>
        <%- include("partials/handleLanguageUnknown") %>
    <% } else { %>
        <%- include("partials/floatingbg") %>
        <%- include("partials/header") %>
        
        <section class="portfolio-container">
            <h2>
                <% if (lang === 'nl') { %>
                    Geselecteerd Werk & Visie
                <% } else if (lang === 'en') { %>
                    Selected Work & Vision
                <% } else { %>
                    <%- include("partials/handleLanguageUnknown") %>
                <% } %>
            </h2>
            
            <div class="portfolio-grid">
                <% 
                let multNumber = 2;
                let plusNumber = 3;
                let projectArrayId = projects.length - 1;

                for (let i = 1; i <= 20; i++) {
                    let project = projects[projectArrayId];
                    
                    if (((multNumber * i) + plusNumber) % 5 <= 1) {
                        
                        if (i % 2 == 0) { 
                            let randomIndex = Math.floor(Math.random() * featureStatements.length);
                            let randomStatement = featureStatements[randomIndex];
                        %>
                            <div class="feature-statement">
                                <p><%= randomStatement %></p>
                            </div>
                        <% } else { 
                            let randomIndex = Math.floor(Math.random() * featureQuotes.length);
                            let randomQuote = featureQuotes[randomIndex];
                        %>
                            <div class="feature-quote">
                                <p><%= randomQuote %></p>
                            </div>
                        <% }
                        
                    } else { 
                        if (project) { 
                            let projectSlug = project.name;
                        %>
                            <a href="/<%= lang %>/projects/<%= projectSlug %>" class="project-card-link">
                                <div class="project-card">
                                    <img src="/assets/project-images/<%= project.name %>.png" alt="<%= project.name %>" class="project-image" loading="lazy">
                                    
                                    <div class="project-info">
                                        <h3><%= project.name %></h3>
                                        <p><%= project.category %></p>
                                    </div>
                                </div>
                            </a>
                        <% } %>
                    <% projectArrayId--; }
                } 
                %>
            </div>
        </section>

        <%- include("partials/footer") %>
    <% } %>
</body>
</html>